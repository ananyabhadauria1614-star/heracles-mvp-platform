{
  "version": 2,
  "builds": [
    { "src": "heracles-mvp/api/index.py", "use": "@vercel/python" },
    { "src": "heracles-mvp/package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "heracles-mvp/api/index.py" },
    { "src": "/(.*\\.(js|css|png|svg|ico|json|woff2?|ttf|eot))", "dest": "/heracles-mvp/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/heracles-mvp/index.html" }
  ]
}